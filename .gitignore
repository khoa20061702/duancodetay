# Thư mục thư viện rất nặng, không đẩy lên Git
node_modules/

# Thư mục sản phẩm sau khi build
dist/
build/

# Các file log rác sinh ra trong quá trình chạy
*.log
.DS_Store

# BẢO MẬT: Bỏ qua tất cả các file .env chứa mật khẩu và API key
.env*
# NGOẠI TRỪ: Giữ lại file .env.example để làm mẫu cho người khác
!.env.example

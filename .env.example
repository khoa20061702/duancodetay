# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Cổng mạng để chạy server (Mặc định 3000)
PORT=3000

# Chuỗi kết nối MongoDB (Mặc định chạy local máy cá nhân)
MONGODB_URI="mongodb://127.0.0.1:27017/phenikaa_news_v2"

# Khóa bí mật dùng để mã hóa chữ ký JWT Token
JWT_SECRET="phenikaa_jwt_super_secret_key_2026"
